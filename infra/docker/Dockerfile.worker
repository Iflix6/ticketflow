# syntax=docker/dockerfile:1

# Worker image: same build pipeline as the API, different entry process (spec: separate processes).
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
# Full install: the build stage needs devDependencies (typescript/tsc) on PATH.
# The runtime image stays small via the `prod-deps` prune stage below.
RUN npm ci --ignore-scripts

FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api/package.json apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/
COPY apps/api/src apps/api/src
COPY apps/worker/package.json apps/worker/tsconfig.json apps/worker/tsconfig.build.json apps/worker/
COPY apps/worker/src apps/worker/src
COPY --from=deps /app/node_modules ./node_modules
RUN npm run build --workspace @ticketflow/config \
 && npm run build --workspace @ticketflow/contracts \
 && npm run build --workspace @ticketflow/worker

# Prune devDependencies only AFTER compilation, so runtime deps and workspace symlinks
# (node_modules/@ticketflow/* -> ../../packages/*) survive into the runtime image.
FROM node:24-alpine AS prod-deps
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps ./apps
COPY --from=build /app/node_modules ./node_modules
RUN npm prune --omit=dev --ignore-scripts

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=local
USER node
# Pruned (production-only) node_modules; workspace symlinks intact.
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/packages/config/package.json ./packages/config/package.json
COPY --from=build --chown=node:node /app/packages/config/dist ./packages/config/dist
COPY --from=build --chown=node:node /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=build --chown=node:node /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build --chown=node:node /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=node:node /app/apps/worker/dist ./apps/worker/dist
# Heartbeat target for the compose healthcheck (container runs read_only with a tmpfs on /tmp).
CMD ["node", "apps/worker/dist/main.js"]
