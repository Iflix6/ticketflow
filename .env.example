# TicketFlow Reliability Lab — example environment.
# Copy to `.env` (gitignored) and adjust. Every value below is a LOCAL DEVELOPMENT default.
# Nothing here is a production credential; production deployments must supply their own secrets
# out of band and the API refuses to start if NODE_ENV=production and values look like these defaults.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=local
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL (authoritative inventory source) ------------------------------
# Local compose default user/db; the password is only valid inside your own Docker network.
DATABASE_URL=postgresql://ticketflow:ticketflow_local_only@localhost:5432/ticketflow
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=2000
IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
TX_MAX_ATTEMPTS=3
TX_BASE_DELAY_MS=20
TX_MAX_DELAY_MS=400

# --- Redis (advisory cache, rate limiting, queues — never allocation truth) ---
REDIS_URL=redis://localhost:6379

# --- Identity / sessions (local demo auth) -----------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=tf_session
SESSION_TTL_HOURS=12
SECURE_COOKIES=false

# --- Booking rules -----------------------------------------------------------
RESERVATION_TTL_SECONDS=300
MAX_QUANTITY_PER_RESERVATION=10
IDEMPOTENCY_TTL_HOURS=24

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Worker / outbox ---------------------------------------------------------
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
SWEEPER_INTERVAL_MS=15000
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5

# --- HTTP hardening ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=100kb

# --- Engineering Lab (local/test only; ADR-0009) ------------------------------
LAB_ENABLED=false
LAB_ADMIN_EMAIL=lab@local.test

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Experiment metadata -----------------------------------------------------
GIT_SHA=
